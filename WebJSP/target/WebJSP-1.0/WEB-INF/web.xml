<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>factorial</servlet-name>
        <servlet-class>com.uma.webjsp.servlets.factorial</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>operaciones</servlet-name>
        <servlet-class>com.uma.webjsp.servlets.operaciones</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>salario</servlet-name>
        <servlet-class>com.uma.webjsp.servlets.salario</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>factorial</servlet-name>
        <url-pattern>/factorial</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>operaciones</servlet-name>
        <url-pattern>/operaciones</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>salario</servlet-name>
        <url-pattern>/salario</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
